// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- USER (Bisa Pelamar / UMKM) ---
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   // "PEKERJA" atau "UMKM"
  
  // Data Profil Tambahan
  phone         String?
  address       String?
  gender        String?  // "L" atau "P" (Khusus Pekerja)
  birthDate     DateTime?
  education     String?
  experience    String?  @db.Text
  
  // Data Usaha (Khusus UMKM)
  businessName  String?
  businessType  String?
  businessDesc  String?  @db.Text

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relasi
  jobs          Job[]          @relation("PostedJobs")      // Lowongan yang dibuat UMKM
  applications  Application[]  @relation("WorkerApplications") // Lamaran yang dikirim Pekerja
}

// --- KATEGORI PEKERJAAN ---
model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  
  jobs  Job[]
}

// --- LOWONGAN KERJA ---
model Job {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  salary      Int      // Gaji (angka murni)
  location    String
  type        String   // Part-Time, Harian, Full-Time
  status      String   @default("OPEN") // OPEN, CLOSED
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relasi Kategori
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])

  // Relasi Pembuat (UMKM)
  authorId    Int
  author      User     @relation("PostedJobs", fields: [authorId], references: [id])

  // Relasi Pelamar
  applicants  Application[]
}

// --- LAMARAN KERJA (Jembatan User & Job) ---
model Application {
  id        Int      @id @default(autoincrement())
  status    String   @default("PENDING") // PENDING, INTERVIEW, REJECTED, ACCEPTED
  note      String?  @db.Text // Pesan singkat dari pelamar
  
  createdAt DateTime @default(now())

  // Relasi
  jobId     Int
  job       Job      @relation(fields: [jobId], references: [id])

  workerId  Int
  worker    User     @relation("WorkerApplications", fields: [workerId], references: [id])

  @@unique([jobId, workerId]) // Mencegah pelamar melamar job yang sama 2x
}